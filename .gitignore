# Local agent state (worktrees, personal settings) stays out; the shared project hooks in
# .claude/settings.json are part of the repository (see CLAUDE.md "Branch model and release flow")
.claude/*
!.claude/settings.json

# ── Private scratch space ──────────────────────────────────────────────
# Personal R&D, experiments, scratch analysis, and anything containing real
# session data lives here and is NEVER committed. This is the project's
# go-forward home for the kind of private artifacts that must stay off the
# public history. See CLAUDE.md for the rationale.
_private/

# Generated demo data (run examples/make_demo.py to recreate)
examples/demo-home/
